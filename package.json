  "description": "Adaptive LSFG-VK frame generation for Armada OS (Decky plugin)",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "echo \"frontend tests: none\" && exit 0"
  },
  "devDependencies": {
    "@decky/api": "^1.1.3",
    "@decky/rollup": "^1.0.1",
